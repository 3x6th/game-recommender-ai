{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource that scrapes the PlayCure backend and AI service",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "End-to-end observability for Java -> Python LangGraph agent -> Java tools.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "text": "DOWN"},
                "1": {"color": "green", "text": "UP"}
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [
        {"expr": "max(up{job=\"ai-service\"})", "refId": "A"}
      ],
      "title": "AI metrics target",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [
        {"expr": "sum(increase(ai_requests_total{provider=~\"$provider\",model=~\"$model\"}[1h]))", "refId": "A"}
      ],
      "title": "AI requests (1h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.99}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [
        {
          "expr": "sum(rate(ai_requests_total{provider=~\"$provider\",model=~\"$model\",outcome=\"success\"}[$__rate_interval])) / clamp_min(sum(rate(ai_requests_total{provider=~\"$provider\",model=~\"$model\"}[$__rate_interval])), 0.000001)",
          "refId": "A"
        }
      ],
      "title": "AI success ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [
        {"expr": "sum(increase(agent_limit_total[1h]))", "refId": "A"}
      ],
      "title": "Agent limits (1h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [
        {"expr": "sum(increase(mock_fallback_total[1h]))", "refId": "A"}
      ],
      "title": "Mock fallbacks (1h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 0},
      "id": 6,
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [
        {"expr": "sum(increase(llm_cost_usd_total{provider=~\"$provider\",model=~\"$model\"}[24h]))", "refId": "A"}
      ],
      "title": "Reported LLM cost (24h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, outcome) (rate(ai_service_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(ai_service_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{outcome}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(ai_service_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{outcome}}",
          "refId": "C"
        }
      ],
      "title": "Java -> Python end-to-end latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, provider, model, outcome) (rate(llm_latency_seconds_bucket{provider=~\"$provider\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p50 {{provider}} {{model}} {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider, model, outcome) (rate(llm_latency_seconds_bucket{provider=~\"$provider\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p95 {{provider}} {{model}} {{outcome}}",
          "refId": "B"
        }
      ],
      "title": "LLM provider latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum by (provider, model, outcome) (rate(ai_requests_total{provider=~\"$provider\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} {{model}} {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(ai_failures_total[$__rate_interval]))",
          "legendFormat": "Java failure: {{reason}}",
          "refId": "B"
        }
      ],
      "title": "AI request outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum by (node, outcome) (rate(agent_steps_total[$__rate_interval]))",
          "legendFormat": "{{node}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "LangGraph node executions",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum by (tool, outcome) (rate(tool_calls_total[$__rate_interval]))",
          "legendFormat": "{{tool}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Tool calls by outcome",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool, outcome) (rate(tool_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{tool}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Python -> Java tool latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "id": 13,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum by (result) (rate(output_validation_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "title": "Output guard decisions",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "id": 14,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum by (provider, model, token_type) (rate(llm_tokens_total{provider=~\"$provider\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} {{model}} {{token_type}}",
          "refId": "A"
        }
      ],
      "title": "LLM token throughput",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["playcure", "ai", "langgraph", "grpc", "deepseek"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(ai_requests_total, provider)",
        "hide": 0,
        "includeAll": true,
        "label": "Provider",
        "multi": true,
        "name": "provider",
        "options": [],
        "query": {"query": "label_values(ai_requests_total, provider)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(ai_requests_total{provider=~\"$provider\"}, model)",
        "hide": 0,
        "includeAll": true,
        "label": "Model",
        "multi": true,
        "name": "model",
        "options": [],
        "query": {"query": "label_values(ai_requests_total{provider=~\"$provider\"}, model)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "PlayCure AI Agent E2E",
  "uid": "playcure-ai-agent",
  "version": 2,
  "weekStart": ""
}
