# AI Service API Keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MAX_TOKENS=2500
# Dev/test only. Production should keep this false and surface retryable errors.
AI_MOCK_FALLBACK_ENABLED=false
# Dev/UI only. The real GigaChat provider is not implemented; responses are
# visibly marked sample data. Never enable this in production.
GIGACHAT_MOCK_ENABLED=false
# Reserved for a future real provider implementation; currently ignored.
# GIGACHAT_API_KEY=

# Service Configuration
GRPC_PORT=9090
HTTP_PORT=8000
BACKEND_PORT=8080

# Headers names
REQUEST_ID_HEADER=rquid

# Logging params constants
REQUEST_ID_LOGGING_PARAM=RqUID
