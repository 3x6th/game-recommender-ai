# AI Service API Keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2500
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=2
AI_AGENT_DEADLINE_SECONDS=30
AI_AGENT_MAX_TOOL_ITERATIONS=3
AI_AGENT_MAX_TOOL_CALLS_PER_ITERATION=4
AI_AGENT_MAX_TOOL_RESULT_CHARS=4000
JAVA_TOOLS_GRPC_TARGET=localhost:9091
JAVA_TOOLS_DEADLINE_SECONDS=2.5
JAVA_TOOLS_MAX_RETRIES=1
JAVA_TOOLS_RETRY_BACKOFF_MS=100
# The real GigaChat provider is not implemented. Local sample data requires
# the explicit GIGACHAT_MOCK_ENABLED=true flag in services/ai-service/.env.
GIGACHAT_MOCK_ENABLED=false

# Service Configuration
GRPC_PORT=9090
HTTP_PORT=8000
BACKEND_PORT=8080

# Optional: Override default hosts for local development
# GRPC_AI_SERVICE_HOST=localhost
# GRPC_AI_SERVICE_PORT=9090

# JWT secrets (backend)
JWT_SECRET=your-jwt-access-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
